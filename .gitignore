# pyenv
#   For a library or app, you might want to share your .python-version if the
#   project is co-developed in multiple versions of Python.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in git.
#   However, in case of collaboration, if delegates have different OS, they may
#   encounter issues with locking.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains specific versions of dependencies
#   installed. Only commit if you want to lock dependencies.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains specific versions of dependencies
#   installed. Only commit if you want to lock dependencies.
#pdm.lock

