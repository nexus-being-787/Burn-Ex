*.swp
*.swo

# Local system files
.DS_Store

# Large datasets / checkpoints if generated locally
# training_data.csv (36MB, can keep or ignore, but good to ignore or commit. Let's ignore it to keep repo light, or commit it if wanted. Usually datasets are ignored)
# pose_landmarker_lite.task (5.7MB, can be downloaded via script)
# Let's keep models/configs but ignore the large CSV to stay light on Github.
training_data.csv
pose_landmarker_lite.task
